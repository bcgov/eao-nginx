# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Zone definitions live here (http context — this file is included from nginx.conf
# inside its http {} block via `include /etc/nginx/conf.d/*.conf`).
# $binary_remote_addr is more compact than $remote_addr (4/16 bytes vs string).
# Zone sizes: 10m ≈ 80k states — adequate for gov-scale traffic.
limit_req_zone  $binary_remote_addr zone=api_general:10m rate=30r/s;
limit_req_zone  $binary_remote_addr zone=api_search:10m  rate=10r/s;
limit_req_zone  $binary_remote_addr zone=analytics:5m    rate=20r/s;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

# Respond 429 Too Many Requests (not default 503) and log at warn not error
limit_req_status  429;
limit_conn_status 429;
limit_req_log_level  warn;
limit_conn_log_level warn;

# Ajax
server {
  listen       8080;
  server_name  ${NGINX__AJAX__SERVER_NAME};

  return 301 https://${NGINX__AJAX__REDIRECT};
}

#EPIC application server
server {
  listen       8080 default_server;
  server_name  ${NGINX__EPIC__SERVER_NAME};

  # Prevent Nginx from prepending scheme/host/port to redirects (prevents HTTP downgrade and port 8080 exposure behind TLS termination)
  absolute_redirect off;
  port_in_redirect off;

  # Allows non-standard headers like SMGOV_USERGUID
  ignore_invalid_headers off;

  # Limit concurrent TCP connections per IP across all locations in this server block
  limit_conn conn_per_ip 50;

  # 172.16.0.0/12 is the entire addressable space in the cluster
  #set_real_ip_from  172.51.0.0/22;
  #set_real_ip_from  172.51.4.0/22;
  #real_ip_header    X-Forwarded-For;

  location / {
    # proxy_pass carries no URI component, so the request URI reaches the upstream unmodified.
    # (This block previously claimed a trailing slash stripped a /proxy prefix. There is no trailing
    # slash here and no /proxy prefix anywhere in this file — the comment described a config that no
    # longer exists, and it sat directly above the line it was describing wrongly.)

    proxy_pass ${NGINX__EPIC__PROXY__ROOT};

    # PREPARED FOR AN EXTERNAL HTTPS ROOT UPSTREAM. NGINX__EPIC__PROXY__ROOT is
    # http://eagle-public:8080 (an in-cluster ClusterIP Service) in every environment today, and this
    # block is written so that flipping it to an https://<endpoint>.azurefd.net Front Door endpoint is
    # a helm values change alone, with no config edit racing the cutover.
    #
    # SNI, for the same reason the /eagle-search/ block below sets it: nginx defaults
    # proxy_ssl_server_name off, so it opens https upstreams with no server name and the peer has to
    # guess which certificate to serve. Measured honestly, this line is insurance rather than a fix
    # for a failure seen today — a bare `*.azurefd.net` default endpoint was probed both ways against
    # nginx/1.27.5 and both returned 200, because the default endpoint has a wildcard certificate and
    # proxy_ssl_verify is off anyway. It becomes load-bearing the moment a custom domain is attached
    # to that endpoint, which is the planned later phase: Front Door then selects a per-domain
    # certificate by SNI, and a handshake with no server name has nothing to select on. Setting it
    # now costs nothing and keeps that phase from being a second config change nobody remembers.
    # Inert against today's http:// upstream — proxy_ssl_* only apply when the proxied scheme is
    # https, verified by serving real requests through this block with the directives in place.
    #
    # NOTE the difference from the /eagle-search/ block below, which sets only proxy_ssl_server_name:
    # there the directive is REQUIRED, because App Service selects its certificate by SNI and a
    # handshake without a server name fails outright. Here it is not required today — a bare
    # *.azurefd.net endpoint answers either way, because it carries a wildcard certificate — and it
    # becomes required only once a custom domain is attached. Two different reasons, same directive.
    proxy_ssl_server_name on;

    # AND VERIFY THE CERTIFICATE. proxy_ssl_server_name only tells the peer which certificate to
    # serve; it does not check what comes back. nginx defaults proxy_ssl_verify OFF, so without
    # these two lines every page request would be proxied over a TLS connection that is encrypted
    # but unauthenticated — anything that can answer for the upstream address gets to serve the
    # entire site, and the padlock in the browser would still be green because rproxy terminates
    # the client's TLS separately. That is worth stating in full precisely because the failure is
    # invisible: an unverified upstream looks identical to a verified one until someone is in the
    # middle. The alpine base image already ships the CA bundle, so this costs nothing.
    # Like the SNI directive above, both are inert while the upstream is plain http://.
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;

    # DNS IS RESOLVED ONCE, AT CONFIG LOAD, AND THAT IS A DELIBERATE CHOICE HERE, NOT AN OVERSIGHT.
    # The textbook fix for a moving cloud IP is a `resolver` plus a variable-form proxy_pass, which
    # re-resolves per request. It was tested against this image (nginx/1.27.5, confirmed with
    # `nginx -v` in a running rproxy pod) and rejected on evidence:
    #
    #   - nginx's resolver does NOT apply the resolv.conf search list. rproxy's resolv.conf is
    #     `search <namespace>.svc.cluster.local svc.cluster.local cluster.local / nameserver <cluster
    #     DNS> / options ndots:5`, so the bare Service name `eagle-public` resolves through libc but
    #     NOT through nginx's own resolver — a probe with `resolver` set and `proxy_pass $var` to a
    #     bare name that `getent hosts` resolves fine logs `could not be resolved (3: Host not
    #     found)` and 502s. Switching this location to variable form therefore breaks 100% of page
    #     traffic TODAY, before any cutover, and takes /lib (same variable) with it. Fixing that
    #     means FQDN-ing the upstream values, which IS the production change this lane must not make.
    #   - `resolver local=on`, which would read the nameserver out of /etc/resolv.conf instead of
    #     hardcoding one, is an Angie extension, not an nginx one. 1.27.5 refuses to start on it:
    #     `[emerg] host not found in resolver "local=on"`. A resolver here would mean pinning a
    #     cluster DNS IP into a template shared by dev, test and prod.
    #   - URI and Host handling were NOT the obstacle: both forms were verified to pass the request
    #     URI through untouched and to send Host: <upstream host>, which is what Front Door routes on.
    #
    # THE ACCEPTED RISK, stated plainly because this location carries every page request: if the
    # Front Door endpoint's anycast IP moves after cutover, nginx keeps using the stale one and the
    # whole site 502s until `oc rollout restart deploy/rproxy`. Endpoint hostnames are stable
    # (`<name>-<hash>.<zone>.azurefd.net`, assigned once at deploy); it is the address behind them
    # that can move. Revisiting this needs two things proven first: every upstream value is an FQDN,
    # and one resolver address is correct in all three namespaces.
    #
    # NOTHING IN THIS FILE WOULD TELL YOU IT HAD HAPPENED. /nginx_status reports connection counts,
    # not upstream health, and the OpenShift readiness probe checks rproxy itself, which stays up
    # and cheerfully returns 502. Detection has to come from outside: an external synthetic check on
    # the site root, or an alert on rproxy's 502 rate. Whoever owns the cutover owns arranging one.
    #
    # TWO OTHER BLOCKS REACH eagle-public AND DO NOT FOLLOW THIS ONE AUTOMATICALLY:
    #   - `location /lib` (below) uses this SAME variable, so it flips at the same instant and has
    #     been given the same proxy_ssl_* directives. Nothing extra to do.
    #   - `location /public` uses NGINX__EPIC__PROXY__PUBLIC, a separate value that also points at
    #     http://eagle-public:8080 in every environment. It does NOT flip with this one, so after a
    #     cutover it would still pin the OpenShift pod and quietly keep it load-bearing. Repoint or
    #     retire it as part of the cutover, not before.

    # Ensure HTTP get passed thru
    proxy_pass_request_headers on;

    # its helpful to cache these responses
    proxy_cache globalcache;

    # Deploy-time configurable
    ${HTTP_BASIC}
  }

  location /public {
    # proxy all traffic to this URL,
    # note the trailing slash strips out the /proxy path on
    # the request to the upstream server

    proxy_pass ${NGINX__EPIC__PROXY__PUBLIC};

    # Ensure HTTP get passed thru
    proxy_pass_request_headers on;

    # its helpful to cache these responses
    proxy_cache globalcache;

    # Deploy-time configurable
    ${HTTP_BASIC2}
  }

  # Redirect SSD fact sheet
  location = /api/public/document/673fa39fe2d737002260aaef/download/Fact_Sheet_PRGT_Substantial-Start-Determination.pdf {
    return 301 https://www2.gov.bc.ca/assets/download/F3F5FA681ADD4912B19A8DE62CBB451E;
  }

  # Redirect legacy /api/analytics path used by cached env.js (pre-v2.4.1)
  location = /api/analytics {
    limit_req zone=analytics burst=30 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__ANALYTICS}/analytics;
    proxy_http_version 1.1;
    proxy_pass_request_headers on;
    proxy_connect_timeout 5s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
  }

  # Analytics API - proxies to penguin-analytics service
  # Used by eagle-public and eagle-admin for anonymous usage tracking
  location /analytics {
    limit_req zone=analytics burst=30 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__ANALYTICS}/analytics;
    proxy_http_version 1.1;
    proxy_pass_request_headers on;
    proxy_connect_timeout 5s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
  }

  # Runtime configuration for the frontends, served by eagle-api from a Config document.
  # Its own block rather than falling through to `location /api`, for two reasons:
  #   - proxy_cache_use_stale: eagle-admin now fails to boot on a failed fetch, so a good config
  #     must outlive a brief eagle-api outage. Failures are never cached — the controller sets
  #     no-store on its 404 and 500.
  #   - timeouts that SUM to under admin's own 5s AbortSignal (1s connect + 3s read = 4s worst
  #     case), or nginx would still be waiting when the browser has already given up and shown
  #     the error page — and use_stale's `timeout` condition could never fire in time to help.
  # Deliberately NO limit_req: the alias this replaces had none, `location /api` uses a per-IP zone
  # shared with every other API call on the page, and a 429 here now white-screens the admin console.
  location = /api/config {
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;

    proxy_cache globalcache;
    proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;

    proxy_connect_timeout 1s;
    proxy_send_timeout    3s;
    proxy_read_timeout    3s;
  }

  # eagle-search (Azure AI Search) — the search backend for Project, Document and DocumentChunk.
  #
  # WHY PROXY IT INSTEAD OF LETTING THE BROWSER CALL AZURE. eagle-public's Content-Security-Policy is
  # `connect-src 'self' https://*.gov.bc.ca` and it is baked into that image, so it cannot vary per
  # environment and it blocks *.azurewebsites.net outright. Same-origin sidesteps the CSP, needs no
  # CORS, and keeps the Azure hostname off the page.
  #
  # PATH REWRITE. Trailing slashes on both sides, so /eagle-search/search?… reaches the upstream as
  # /api/search?…. eagle-public sends SEARCH_API_PATH=/eagle-search (from the ConfigMap) and appends
  # `search?…` itself.
  #
  # NOT /search-api/ — that path existed here and was removed in d7dc62c, "remove /search-api direct
  # Typesense exposure". Reusing the name would make that commit read as reverted.
  #
  # FIRST EXTERNAL HTTPS UPSTREAM IN THIS FILE. Two consequences:
  #   - proxy_ssl_server_name is required; App Service needs SNI and nginx defaults it off.
  #   - There is no `resolver` here, so nginx resolves this hostname ONCE, at config load. Every
  #     other upstream is a ClusterIP Service, where that has never mattered. If an App Service IP
  #     moves, this location 502s while the name resolves fine everywhere else; the fix is
  #     `oc rollout restart deploy/rproxy`.
  #
  # No proxy_cache, unlike the Typesense blocks below: eagle-search sends no cache headers, so it
  # would be inert today and an ACL leak the day this endpoint learns about authentication.
  location ^~ /eagle-search/ {
    limit_req zone=api_search burst=20 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__SEARCH}/api/;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  location ^~ /api/demi/ {
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=5 nodelay;
    proxy_connect_timeout 10s;
    proxy_send_timeout    330s;
    proxy_read_timeout    330s;
  }

  # Legacy v2 projects routing rewrite to current /api/public/project
  location ~ ^/api/v2/projects/(.+)$ {
    rewrite ^/api/v2/projects/(.+)$ /api/public/project/$1 break;
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=50 nodelay;
    proxy_cache globalcache;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
  }

  location = /api/v2/projects {
    rewrite ^/api/v2/projects$ /api/public/project break;
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=50 nodelay;
    proxy_cache globalcache;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
  }

  location /api {
    # proxy all traffic to this URL,
    # note the trailing slash strips out the /proxy path on
    # the request to the upstream server

    proxy_pass ${NGINX__EPIC__PROXY__API};

    # Ensure HTTP get passed thru
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=50 nodelay;

    # Cache public (unauthenticated) API responses only.
    # Authenticated requests bypass cache — admin users need fresh data
    # after mutations (delete, publish, etc.).
    proxy_cache globalcache;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;

    # Explicit timeouts — must be lower than HAProxy route timeout (180s)
    # so nginx fails first with a clean error rather than a generic 504.
    # 120s gives headroom for large document uploads and slow aggregations.
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
  }

  # Redirect /admin to /admin/ to avoid port exposure in redirects
  location = /admin {
    absolute_redirect off;
    return 301 /admin/;
  }

  location /admin/ {
    # proxy all traffic to this URL,
    # note the trailing slash strips out the /proxy path on
    # the request to the upstream server

    proxy_pass ${NGINX__EPIC__PROXY__ADMIN};

    # Ensure HTTP get passed thru
    proxy_pass_request_headers on;

    # its helpful to cache these responses
    proxy_cache globalcache;
  }

  # For e-guide service
  location /eguide {
    proxy_pass ${NGINX__EPIC__PROXY__EGUIDE};

    # Ensure HTTP get passed thru
    proxy_pass_request_headers on;

    # its helpful to cache these responses
    proxy_cache globalcache;

    ${HTTP_BASIC1}
  }

#  location /.well-known/acme-challenge {
#    proxy_pass ${NGINX__EPIC__PROXY__CERTBOT};
#
#    # Ensure HTTP get passed thru
#    proxy_pass_request_headers on;
#
#    # its helpful to cache these responses
#    proxy_cache globalcache;
#  }

  # Cache the lib directory
  location /lib {
    proxy_pass ${NGINX__EPIC__PROXY__ROOT};
    # Same variable as `location /`, so this block goes external on the same day and wants the same
    # TLS settings, for the reasoning written out up there. Easy to miss precisely because it is a
    # small legacy path that no page obviously depends on. Verification matters as much here as on
    # the root: this location is cached, so one unverified response can be served to many clients.
    # All four are inert against today's http:// upstream.
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;
    proxy_cache   globalcache;
  }

  # For status of ngnix service
  location /nginx_status {
    # Enable Nginx stats
    stub_status on;
    # Allow access from Kubernetes pods (10.0.0.0/8 covers OpenShift SDN)
    allow 10.0.0.0/8;
    # Allow localhost
    allow 127.0.0.1;
    # Other requests should be denied
    deny all;
    # No need to log this request, its just noise
    access_log off;
  }
}
