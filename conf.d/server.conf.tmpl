# Zone definitions sit here because nginx.conf includes this file inside its http {} block.
limit_req_zone  $binary_remote_addr zone=api_general:10m rate=30r/s;
limit_req_zone  $binary_remote_addr zone=api_search:10m  rate=10r/s;
limit_req_zone  $binary_remote_addr zone=analytics:5m    rate=20r/s;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

# Respond 429 Too Many Requests (not default 503) and log at warn not error
limit_req_status  429;
limit_conn_status 429;
limit_req_log_level  warn;
limit_conn_log_level warn;

server {
  listen       8080;
  server_name  ${NGINX__AJAX__SERVER_NAME};

  return 301 https://${NGINX__AJAX__REDIRECT};
}

server {
  listen       8080 default_server;
  server_name  ${NGINX__EPIC__SERVER_NAME};

  # Relative redirects only: behind TLS termination an absolute one would carry http:// and :8080.
  absolute_redirect off;
  port_in_redirect off;

  # Allows non-standard headers like SMGOV_USERGUID
  ignore_invalid_headers off;

  limit_conn conn_per_ip 50;

  location / {
    proxy_pass ${NGINX__EPIC__PROXY__ROOT};
    proxy_pass_request_headers on;

    # Strip the basic-auth credential, for the reason at `location = /demi-search/search`.
    proxy_set_header Authorization "";

    proxy_cache globalcache;

    # Front Door needs SNI, and nginx defaults proxy_ssl_server_name off.
    proxy_ssl_server_name on;

    # Never set `Host $host` here: Front Door answers 421. It routes on the default $proxy_host.

    # TLS verify stays off. Turning it on needs proxy_ssl_trusted_certificate plus verify_depth 3,
    # because the Front Door chain is 4 deep and the default depth 1 returns 502.

    # No `resolver` in this file, so upstream names resolve once at load. If an upstream IP moves,
    # it 502s while the probes stay green; fix with `oc rollout restart deploy/rproxy`.
    ${HTTP_BASIC}
  }

  location = /api/public/document/673fa39fe2d737002260aaef/download/Fact_Sheet_PRGT_Substantial-Start-Determination.pdf {
    return 301 https://www2.gov.bc.ca/assets/download/F3F5FA681ADD4912B19A8DE62CBB451E;
  }

  # Cached env.js still calls /api/analytics. Internal rewrite, so `location = /analytics` decides.
  location = /api/analytics {
    rewrite ^ /analytics last;
  }

  # /api/usage/ is the same APIM gateway as /analytics/ under a neutral prefix, because ad blockers
  # drop any URL containing "analytics". Browsers call /api/usage/.

  # The endpoint is gone, and cached bundles may still POST here.
  location = /analytics {
    return 410;
  }

  # GC Notify webhook. A longer prefix than `^~ /analytics/`, so it never reaches the gateway and
  # the caller's Authorization header never leaves the cluster.
  location ^~ /analytics/webhook/ {
    return 410;
  }

  # Without the slash-less spelling, this URL falls to `^~ /analytics/` and sends Authorization out.
  location = /analytics/webhook {
    return 410;
  }

  # No Authorization strip: the bearer on /query and /dashboards is the authorization. Timeouts
  # cover the scale-to-zero Function behind the gateway, whose cold start runs past 10s.
  location ^~ /analytics/ {
    limit_req zone=analytics burst=30 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__ANALYTICS}/analytics/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # Anonymous ingest: strips the credential, for the reason at `location = /demi-search/search`.
  location ^~ /analytics/events {
    limit_req zone=analytics burst=30 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__ANALYTICS}/analytics/events;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # Browser-facing spelling of `^~ /analytics/`: proxy_pass maps /api/usage/x to /analytics/x.
  # `^~` on the longer prefix beats `location /api`, so order in this file does not matter.
  location ^~ /api/usage/ {
    limit_req zone=analytics burst=30 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__ANALYTICS}/analytics/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # Mirrors `^~ /analytics/events`, including the credential strip.
  location ^~ /api/usage/events {
    limit_req zone=analytics burst=30 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__ANALYTICS}/analytics/events;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # 1s connect + 3s read stays under admin's 5s abort, so use_stale can still serve a good config.
  # No limit_req: a 429 here white-screens the admin console.
  location = /api/config {
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;

    proxy_cache globalcache;
    proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;

    proxy_connect_timeout 1s;
    proxy_send_timeout    3s;
    proxy_read_timeout    3s;
  }

  # Same-origin because eagle-public's CSP connect-src blocks *.azurewebsites.net. Trailing slashes
  # map /eagle-search/x to /api/x. No proxy_cache: it would leak across users once auth is added.
  location ^~ /eagle-search/ {
    limit_req zone=api_search burst=20 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__SEARCH}/api/;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # Exact match is the security control: a prefix would publish demi-api's whole route table
  # anonymously. A URL that has to work gets its own location; never relax this into a prefix.
  location = /demi-search/search {
    # HTTP_BASIC so this location is not anonymous in dev and test while the pages around it are.
    ${HTTP_BASIC}
    limit_req zone=api_search burst=20 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__DEMI}/api/search;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    # HTTP_BASIC makes the browser send the shared dev/test credential, and forwarding headers would
    # carry it out of the cluster. The gate is still enforced here, before proxy_pass.
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # X-Forwarded-For passes through as the router set it. Which hop to trust is demi's decision
  # (TRUSTED_PROXY_IPS there); appending here would add the router hop, not the browser.
  location ^~ /demi-search/bulk-downloads {
    ${HTTP_BASIC}
    limit_req zone=api_search burst=20 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__DEMI}/api/bulk-downloads;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # 1s connect + 10s read stays under the react line's 12s abort. limit_req is safe here because
  # eagle-public falls back to /api/config when this fails.
  location = /demi-search/config {
    ${HTTP_BASIC}
    limit_req zone=api_search burst=20 nodelay;
    proxy_pass ${NGINX__EPIC__PROXY__DEMI}/api/config/public;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    # Strip the credential, for the reason at `location = /demi-search/search`.
    proxy_set_header Authorization "";

    proxy_cache globalcache;
    proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
    proxy_cache_valid 200 1m;

    proxy_connect_timeout 1s;
    proxy_send_timeout    3s;
    proxy_read_timeout    10s;
  }

  location = /demi-search/gate {
    ${HTTP_BASIC}
    limit_req zone=api_search burst=20 nodelay;
    limit_except POST { deny all; }
    proxy_pass ${NGINX__EPIC__PROXY__DEMI}/api/gate;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
  }

  # The default cache key carries the query string, so each ?limit=N caches apart. Upstream
  # Cache-Control decides freshness; proxy_cache_valid is only the fallback.
  location = /demi-search/documents/recent-uploads {
    ${HTTP_BASIC}
    limit_req zone=api_search burst=20 nodelay;
    limit_except GET { deny all; }
    proxy_pass ${NGINX__EPIC__PROXY__DEMI}/api/documents/recent-uploads;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    # Strip the credential, for the reason at `location = /demi-search/search`.
    proxy_set_header Authorization "";

    proxy_cache globalcache;
    proxy_cache_bypass $http_x_api_key;
    proxy_no_cache $http_x_api_key;
    proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
    proxy_cache_valid 200 1m;

    proxy_connect_timeout 1s;
    proxy_send_timeout    3s;
    proxy_read_timeout    10s;
  }

  location ~ "^/demi-search/documents/([0-9a-f]{24})/download$" {
    ${HTTP_BASIC}
    limit_req zone=api_general burst=10 nodelay;
    limit_except GET { deny all; }
    rewrite "^/demi-search/documents/([0-9a-f]{24})/download$" /api/documents/$1/download break;
    proxy_pass ${NGINX__EPIC__PROXY__DEMI};
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }

  # Terminator: plain prefix, so the regex above is tried first. Non-matches 404 here instead of
  # falling to `location /` and looping through Front Door to a 504.
  location /demi-search/documents/ {
    return 404;
  }

  location ^~ /s/ {
    ${HTTP_BASIC}
    limit_req zone=api_general burst=10 nodelay;
    # Keep the /s/ prefix in the URI. A bare host or /api/ would map /s/projects onto demi-api's
    # /projects and publish its whole route table.
    proxy_pass ${NGINX__EPIC__PROXY__DEMI}/api/s/;
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }

  # Regexes are quoted because a bare `{` opens a block. The id goes in the URI, not the upstream,
  # so the name resolves once at load.
  location ~ "^/demi-projects/[0-9a-f]{24}$" {
    ${HTTP_BASIC}
    limit_req zone=api_general burst=10 nodelay;
    limit_except GET { deny all; }
    rewrite "^/demi-projects/([0-9a-f]{24})$" /api/projects/$1 break;
    proxy_pass ${NGINX__EPIC__PROXY__DEMI};
    proxy_ssl_server_name on;
    proxy_pass_request_headers on;
    proxy_set_header Authorization "";
    proxy_connect_timeout 10s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }

  # Terminator: plain prefix, so the regex above is tried first. Non-matches 404 here instead of
  # falling to `location /` and looping through Front Door to a 504.
  location /demi-projects/ {
    return 404;
  }

  # v2 projects routes rewrite to /api/public/project.
  location ~ ^/api/v2/projects/(.+)$ {
    rewrite ^/api/v2/projects/(.+)$ /api/public/project/$1 break;
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=50 nodelay;
    proxy_cache globalcache;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
  }

  location = /api/v2/projects {
    rewrite ^/api/v2/projects$ /api/public/project break;
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=50 nodelay;
    proxy_cache globalcache;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
  }

  location /api {
    proxy_pass ${NGINX__EPIC__PROXY__API};
    proxy_pass_request_headers on;
    limit_req zone=api_general burst=50 nodelay;

    # Cache anonymous responses only; admins need fresh data after a write.
    proxy_cache globalcache;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;

    # Below the Route's haproxy timeout (values.yaml `route.timeout`), so nginx fails first with a
    # clean error. 120s covers large uploads and slow aggregations.
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
  }

  # Redirect /admin to /admin/ to avoid port exposure in redirects
  location = /admin {
    absolute_redirect off;
    return 301 /admin/;
  }

  location /admin/ {
    # proxy all traffic to this URL,
    # note the trailing slash strips out the /proxy path on
    # the request to the upstream server

    proxy_pass ${NGINX__EPIC__PROXY__ADMIN};

    # Ensure HTTP get passed thru
    proxy_pass_request_headers on;

    # its helpful to cache these responses
    proxy_cache globalcache;
  }

  location /eguide {
    proxy_pass ${NGINX__EPIC__PROXY__EGUIDE};
    proxy_pass_request_headers on;
    proxy_cache globalcache;

    ${HTTP_BASIC1}
  }

  location /nginx_status {
    stub_status on;
    # 10.0.0.0/8 covers the OpenShift SDN, where the probes come from.
    allow 10.0.0.0/8;
    allow 127.0.0.1;
    deny all;
    access_log off;
  }

  # Front Door origin health probe. Answers from nginx itself so origin health never depends on
  # eagle-api or any upstream. Not logged: the edge probes every 120 s from many POPs.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
}
